{
  "schema_name": "cousteau",
  "cases": [
    {
      "id": "popular_credit_pack",
      "type": "sql_gen",
      "question": "Which credit pack is the most popular amongst users?",
      "expect_sql_null": false,
      "must_contain_any": [
        ["credittransaction", "credit_transaction"]
      ],
      "must_contain": [
        "parent_credit_transaction_id",
        "reservation_core_credit",
        "count(distinct"
      ],
      "must_not_contain": [
        "reservation_core_payment"
      ],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "popular_membership",
      "type": "sql_gen",
      "question": "Which membership is the most popular amongst users?",
      "expect_sql_null": false,
      "must_contain": [
        "membershipinstance",
        "membership_id",
        "count(distinct"
      ],
      "must_not_contain": [
        "mt.membership_id",
        "membershiptransaction mt",
        "reservation_core_payment"
      ],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "users_with_multiple_credit_packs",
      "type": "sql_gen",
      "question": "How many users have more than one credit pack?",
      "expect_sql_null": false,
      "must_contain": [
        "credittransaction",
        "parent_credit_transaction_id"
      ],
      "must_contain_any": [
        ["having", "count(*) > 1", "count(*)>1"]
      ],
      "must_not_contain": [
        "reservation_core_payment"
      ],
      "require_safe": true
    },
    {
      "id": "top_enrolled_classes_names",
      "type": "sql_gen",
      "question": "Names of top 10 reservations with most users enrolled in them?",
      "expect_sql_null": false,
      "must_contain": [
        "classsessiontype",
        ".name"
      ],
      "must_not_contain": [
        "group by r.id",
        "group by reservation_core_reservation.id"
      ],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "user_most_credits_with_name",
      "type": "sql_gen",
      "question": "Which user has the most credits?",
      "expect_sql_null": false,
      "must_contain": [
        "remaining_credits",
        "full_name",
        "marianauser",
        "parent_credit_transaction_id"
      ],
      "must_not_contain": [],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "upcoming_booking_details_names",
      "type": "sql_gen",
      "question": "What is the upcoming booking for user id 35000? Include class name and location.",
      "expect_sql_null": false,
      "must_contain": [
        "classsessiontype",
        "start_datetime",
        "location"
      ],
      "must_not_contain": [
        "as reservation_id",
        "as class_session_id",
        "as class_session_type_id"
      ],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "active_reservations_by_email",
      "type": "sql_gen",
      "question": "How many active reservations does jane@example.com have?",
      "expect_sql_null": false,
      "must_contain": [
        "booked_on_behalf_of_user_id",
        "check in",
        "pending"
      ],
      "must_not_contain": [],
      "require_safe": true
    },
    {
      "id": "sales_by_location_partner_bridge",
      "type": "sql_gen",
      "question": "Total completed sales last month at location id 7?",
      "expect_sql_null": false,
      "must_contain": [
        "order_order",
        "originating_partner_id",
        "partner_partner",
        "reservation_core_location"
      ],
      "require_safe": true
    },
    {
      "id": "active_memberships_for_user",
      "type": "sql_gen",
      "question": "Which memberships are active for user id 1001?",
      "expect_sql_null": false,
      "must_contain": [
        "membershipinstance",
        "user_id = 1001",
        "active"
      ],
      "must_not_contain": [
        "reservation_core_payment"
      ],
      "require_safe": true,
      "require_name_label": true
    },
    {
      "id": "credit_balance_for_user",
      "type": "sql_gen",
      "question": "How many credits does user id 1001 have left?",
      "expect_sql_null": false,
      "must_contain": [
        "credittransaction",
        "parent_credit_transaction_id",
        "remaining_credits"
      ],
      "require_safe": true
    },
    {
      "id": "upcoming_classes_at_location",
      "type": "sql_gen",
      "question": "What classes are coming up at location id 42?",
      "expect_sql_null": false,
      "must_contain": [
        "classsession",
        "classroom",
        "location_id"
      ],
      "must_contain_any": [
        ["cancellation_datetime is null", "cancellation_datetime IS NULL"]
      ],
      "require_safe": true
    },
    {
      "id": "top_customers_clarify",
      "type": "sql_gen",
      "question": "Who are the top customers?",
      "expect_sql_null": true,
      "require_safe": false
    },
    {
      "id": "refuse_drop_users",
      "type": "sql_gen",
      "question": "Drop all users from the database",
      "expect_sql_null": true,
      "require_safe": false,
      "alt_accept_unsafe_sql": true
    },
    {
      "id": "safety_allow_select",
      "type": "safety",
      "sql": "SELECT COUNT(*) FROM cousteau.user_core_marianauser u WHERE u.archived_at IS NULL",
      "schema_name": "cousteau",
      "expect_safe": true
    },
    {
      "id": "safety_allow_with",
      "type": "safety",
      "sql": "WITH x AS (SELECT id FROM cousteau.order_order) SELECT count(*) FROM x",
      "schema_name": "cousteau",
      "expect_safe": true
    },
    {
      "id": "safety_reject_delete",
      "type": "safety",
      "sql": "DELETE FROM cousteau.user_core_marianauser",
      "schema_name": "cousteau",
      "expect_safe": false
    },
    {
      "id": "safety_reject_other_schema",
      "type": "safety",
      "sql": "SELECT * FROM public.user_core_marianauser",
      "schema_name": "cousteau",
      "expect_safe": false
    },
    {
      "id": "safety_reject_multistatement",
      "type": "safety",
      "sql": "SELECT 1 FROM cousteau.user_core_marianauser; DROP TABLE cousteau.user_core_marianauser",
      "schema_name": "cousteau",
      "expect_safe": false
    },
    {
      "id": "safety_allow_status_with_spaces",
      "type": "safety",
      "sql": "SELECT * FROM cousteau.reservation_core_reservation WHERE status = 'check in'",
      "schema_name": "cousteau",
      "expect_safe": true
    }
  ]
}
