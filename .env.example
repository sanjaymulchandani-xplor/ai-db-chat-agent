# OpenAI
OPENAI_API_KEY=sk-...

# PostgreSQL connection string
# e.g. postgresql://user:password@host:5432/dbname
CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb

# Optional overrides
# Prompt style used for SQL generation: "cot" (chain-of-thought) or "simple"
PROMPT_STYLE=cot
# Set to "1" or "true" to print the full schema context sent to the model
DEBUG_SCHEMA=false

# Optional: override default SQLite DB paths
# SESSION_MEMORY_DB=/path/to/session_memory.db
# APP_SECRETS_DB=/path/to/app_secrets.db
